  grid-template-columns: minmax(260px, 0.46fr) minmax(0, 1fr);
  gap: 1px;
  margin-bottom: 34px;
  background: var(--line);
}

.menu-board-photo {
  position: relative;
  overflow: hidden;
  min-height: 100%;
  margin: 0;
  background: #0f0a08;
}

.menu-board-photo::after {
  position: absolute;
  inset: 0;
  content: "";
  background: linear-gradient(180deg, rgba(19, 13, 10, 0.1), rgba(19, 13, 10, 0.74));
  pointer-events: none;
}

.menu-board-photo img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 420px;
  object-fit: cover;
  filter: brightness(0.74) saturate(0.92) contrast(1.06);
}

.menu-list {
  display: grid;
  gap: 1px;
  background: var(--line);
}

.menu-list article {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 18px;
  align-items: center;
  padding: 18px 22px;
  background: #19100c;
}

.menu-list h3 {
  margin: 0 0 5px;
  color: var(--cream);
  font-size: clamp(1.08rem, 2vw, 1.48rem);
  font-weight: 800;
  line-height: 1.2;
}

.menu-list p {
  margin: 0;
  color: var(--muted);
  font-family: var(--font-ui);
  font-weight: 760;
}

.menu-list strong {
  color: var(--amber);
  font-family: var(--font-ui);
  font-size: clamp(1.05rem, 1.8vw, 1.36rem);
  white-space: nowrap;
}

.menu-order-button {
  grid-column: 1 / -1;
  justify-self: stretch;
}

.event {
  display: grid;
  grid-template-columns: minmax(170px, 0.34fr) minmax(0, 1fr) auto;
  gap: 24px;
  align-items: center;
  padding: 18px;
  background: var(--dark);
}

.event-photo {
  position: relative;
  overflow: hidden;
  margin: 0;
  border: 1px solid rgba(245, 239, 226, 0.16);
  background: #0f0a08;
}

.event-photo img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  filter: brightness(0.78) saturate(0.9) contrast(1.06);
}

.event-copy {
  display: grid;
  gap: 10px;
}

.event-copy h2 {
  margin: 0;
  font-size: clamp(2rem, 4.8vw, 4.3rem);
}

.event-copy p,
.event-meta {
  margin: 0;
  color: var(--muted);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
}

.event-meta {
  display: grid;
  gap: 6px;
}

.text-link {
  justify-self: end;
  border-bottom: 1px solid currentColor;
  color: var(--cream);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  font-size: 0.9rem;
  white-space: nowrap;
}

.pint {
  padding: var(--section-pad);
  border-top: 1px solid var(--line);
  text-align: center;
}

.pint h2 {
  margin-bottom: 30px;
}

.custom-image-panel {
  display: grid;
  gap: 18px;
  width: min(100%, 1320px);
  margin: 0 auto;
  text-align: left;
}

.custom-image-panel .section-label {
  margin-bottom: 0;
}

.custom-image-note,
.custom-image-hint {
  margin: 0;
  color: var(--muted);
  font-family: var(--font-ui);
  line-height: 1.6;
}

.custom-image-note code,
.custom-image-hint code {
  padding: 0 6px;
  background: rgba(245, 239, 226, 0.08);
  color: var(--cream);
}

.custom-image-slot {
  position: relative;
  display: grid;
  min-height: clamp(280px, 52vw, 560px);
  margin: 0;
  place-items: center;
  overflow: hidden;
  border: 1px solid var(--line);
  background:
    linear-gradient(180deg, rgba(19, 13, 10, 0.16), rgba(19, 13, 10, 0.78)),
    url("data:image/jpeg;base64,") center / cover;
}

.custom-image-slot::before {
  position: absolute;
  inset: 14px;
  border: 1px dashed rgba(245, 239, 226, 0.18);
  content: "";
}

.custom-image-placeholder {
  display: none;
}

.pint-gallery {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) repeat(2, minmax(0, 0.58fr));
  gap: 10px;
  width: min(100%, 1320px);
  margin: 0 auto;
}

.pint-shot {
  position: relative;
  overflow: hidden;
  min-height: 180px;
  margin: 0;
  border: 1px solid var(--line);
  background: #0f0a08;
}

.pint-shot::after {
  position: absolute;
  inset: 0;
  content: "";
  background: linear-gradient(180deg, transparent 46%, rgba(19, 13, 10, 0.5));
  pointer-events: none;
}

.pint-shot-large {
  grid-row: span 2;
}

.pint-shot img {
  display: block;
  width: 100%;
  height: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  filter: saturate(0.95) contrast(1.04);
}

.pint-shot-large img {
  aspect-ratio: 4 / 3;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1px;
  background: var(--line);
}

.menu-grid article {
  position: relative;
  overflow: hidden;
  min-height: 190px;
  padding: 22px;
  background: #19100c;
}

.beer-card::before {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  content: "";
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  opacity: 0.58;
  pointer-events: none;
}

.beer-card::after {
  position: absolute;
  inset: 0;
  z-index: 0;
  content: "";
  background: linear-gradient(180deg, rgba(19, 13, 10, 0.16), rgba(19, 13, 10, 0.84));
  pointer-events: none;
}

.tiger-card::before {
  background-image: url("data:image/jpeg;base64,");
}

.calsberg-card::before {
  background-image: url("data:image/jpeg;base64,");
}

.heineken-card::before {
  background-image: url("data:image/jpeg;base64,");
}

.guinness-card::before {
  background-image: url("data:image/jpeg;base64,");
}

.menu-grid span {
  position: relative;
  z-index: 2;
  display: block;
  margin-bottom: 82px;
  color: var(--cream);
  font-size: 1.45rem;
}

.menu-grid p {
  position: relative;
  z-index: 2;
  margin: 0;
  color: var(--muted);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  line-height: 1.6;
}

.reserve {
  padding: var(--section-pad);
  border-top: 1px solid var(--line);
  background: #e8ded0;
  color: #18110d;
}

.reserve h2 {
  color: #18110d;
  text-align: center;
}

form {
  display: grid;
  max-width: 1060px;
  grid-template-columns: repeat(6, 1fr);
  gap: 1px;
  margin: 30px auto 0;
  background: rgba(24, 17, 13, 0.28);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
}

label {
  display: grid;
  gap: 9px;
  padding: 14px;
  background: #f5efe2;
}

label span {
  color: #5d5043;
  font-size: 0.78rem;
  font-weight: 760;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

select,
input {
  width: 100%;
  border: 0;
  background: transparent;
  color: #18110d;
  font: inherit;
  outline: none;
}

form button {
  min-height: 70px;
  border-color: #18110d;
  background: #18110d;
  color: var(--cream);
}

form button:hover {
  background: #3a291d;
  color: var(--cream);
}

.reserve-message {
  max-width: 1060px;
  min-height: 24px;
  margin: 22px auto 0;
  color: #18110d;
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  font-weight: 760;
  line-height: 1.5;
  text-align: center;
}

.reserve-message a {
  border-bottom: 1px solid currentColor;
}

.reserve-message.is-error {
  color: #9c1f1f;
}

.reserve-actions {
  display: flex;
  justify-content: center;
  margin: 20px auto 0;
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
}

.reserve-call {
  border-bottom: 1px solid currentColor;
  color: #18110d;
  font-weight: 800;
}

.location {
  display: grid;
  gap: 34px;
  padding: var(--section-pad);
  border-top: 1px solid var(--line);
  background: var(--dark);
}

.location h2 {
  margin: 14px 0 0;
  color: var(--cream);
  font-size: clamp(2.3rem, 6vw, 5.8rem);
  font-weight: 400;
  line-height: 1;
}

.map-link {
  display: inline-flex;
  margin-top: 24px;
  border-bottom: 1px solid currentColor;
  color: var(--cream);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  font-weight: 800;
}

.map-preview {
  position: relative;
  display: grid;
  min-height: 320px;
  align-content: center;
  justify-items: center;
  border: 1px solid var(--line);
  background:
    linear-gradient(90deg, rgba(19, 13, 10, 0.86), rgba(19, 13, 10, 0.44), rgba(19, 13, 10, 0.86)),
    linear-gradient(0deg, rgba(245, 239, 226, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(245, 239, 226, 0.08) 1px, transparent 1px),
    #1a1512;
  background-size: auto, 88px 88px, 88px 88px, auto;
  color: var(--cream);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  text-align: center;
}

.map-preview::before {
  width: 34px;
  height: 34px;
  margin-bottom: 18px;
  border: 8px solid var(--amber);
  border-radius: 50% 50% 50% 0;
  content: "";
  transform: rotate(-45deg);
}

.map-preview span {
  margin-bottom: 10px;
  color: var(--muted);
  font-size: 0.82rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.map-preview strong {
  font-size: clamp(2rem, 5vw, 4.6rem);
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 400;
}

.site-footer {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 28px;
  padding: 54px clamp(20px, 6vw, 88px);
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
}

.site-footer p {
  margin-bottom: 8px;
}

.site-footer p:first-child {
  color: var(--cream);
  font-weight: 760;
}

.site-footer a {
  display: block;
  margin-bottom: 8px;
