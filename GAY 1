@media (max-width: 920px) {
  .site-header {
    grid-template-columns: auto 1fr;
  }

  nav {
    justify-self: end;
    gap: 16px;
  }

  .hours,
  .whats-on,
  .menu {
    grid-template-columns: 1fr;
  }

  .hours-photo {
    border-top: 0;
    border-left: 1px solid rgba(245, 239, 226, 0.1);
  }

  .event {
    grid-template-columns: minmax(140px, 0.42fr) minmax(0, 1fr);
    gap: 14px;
  }

  .text-link {
    grid-column: 1 / -1;
    justify-self: start;
  }

  .menu-board,
  .menu-grid,
  .pint-gallery,
  form,
  .site-footer {
    grid-template-columns: 1fr 1fr;
  }

  form button {
    grid-column: 1 / -1;
  }

  .pint-shot-large {
    grid-column: 1 / -1;
    grid-row: auto;
  }
}

@media (max-width: 640px) {
  :root {
    --section-pad: 42px 16px;
  }

  .site-header {
    position: sticky;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
  }

  .brand {
    width: 88px;
    flex: 0 0 auto;
