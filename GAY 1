  line-height: 1;
}

.whats-on-content {
  display: grid;
  grid-column: 1 / 2;
  gap: 22px;
}

.whats-on-photo {
  position: relative;
  overflow: hidden;
  margin: 0;
  border: 1px solid var(--line);
  background: #0f0a08;
}

.whats-on-photo::after {
  position: absolute;
  inset: 0;
  content: "";
  background: linear-gradient(180deg, transparent 52%, rgba(19, 13, 10, 0.62));
  pointer-events: none;
}

.whats-on-photo img {
