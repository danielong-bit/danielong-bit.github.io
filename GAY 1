  text-align: center;
}

.hours h2 {
  margin-bottom: 38px;
  color: var(--cream);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  font-size: clamp(1.7rem, 3vw, 2.3rem);
  font-weight: 800;
}

.hours-list {
  display: grid;
  gap: 28px;
}

.hours-list p {
  margin: 0;
  color: var(--cream);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  font-size: clamp(1rem, 1.7vw, 1.18rem);
  font-weight: 760;
  line-height: 1.55;
  text-transform: uppercase;
}

.hours-list span {
  display: block;
  color: var(--amber);
}

.hours-photo {
