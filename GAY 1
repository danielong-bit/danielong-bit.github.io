    <style>
:root {
  color-scheme: dark;
  --font-ui: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", "Source Han Sans SC", "Heiti SC", sans-serif;
  --ink: #f5efe2;
  --muted: #c3b7a2;
  --soft: #8f806a;
  --line: rgba(245, 239, 226, 0.26);
  --dark: #130d0a;
  --brown: #251810;
  --amber: #d39a43;
  --green: #66735a;
  --cream: #fff8e8;
  --radius: 0;
  --section-pad: clamp(48px, 7vw, 96px) clamp(18px, 5vw, 64px);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background: var(--dark);
  color: var(--ink);
  font-family: Georgia, "Times New Roman", serif;
  letter-spacing: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
}

h1,
h2,
h3,
p,
a,
button,
label span,
.event-meta {
  overflow-wrap: break-word;
}

body,
button,
input,
select,
textarea,
nav,
.hero-kicker,
.eyebrow,
h1,
h2,
h3,
address,
.hours-list p,
.section-label,
.event-copy p,
.event-meta,
.text-link,
.reserve,
.reserve-message,
.reserve-actions,
.map-link,
.map-preview,
.site-footer {
  font-family: var(--font-ui) !important;
}

.site-header {
  position: fixed;
  inset: 0 0 auto;
  z-index: 10;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 14px clamp(20px, 5vw, 64px);
  background: rgba(19, 13, 10, 0.76);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(12px);
}

.brand {
  display: inline-flex;
  width: clamp(104px, 12vw, 156px);
  align-items: center;
}

.brand img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.3));
}

nav {
  grid-column: 2;
  display: flex;
  gap: clamp(14px, 3vw, 42px);
  color: var(--muted);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  font-size: 0.86rem;
}

nav a:hover {
  color: var(--cream);
}

.hero {
  position: relative;
  display: grid;
  grid-template-rows: auto auto auto;
  gap: clamp(18px, 3vh, 30px);
  align-content: center;
  justify-items: center;
  min-height: 100svh;
  padding: 120px clamp(20px, 5vw, 64px) 52px;
  isolation: isolate;
  text-align: center;
}

.hero::before {
  position: absolute;
  inset: 0;
  z-index: -2;
  content: "";
  background:
    linear-gradient(90deg, rgba(19, 13, 10, 0.96), rgba(19, 13, 10, 0.38), rgba(19, 13, 10, 0.96)),
    linear-gradient(180deg, rgba(19, 13, 10, 0.22), rgba(19, 13, 10, 0.96)),
    url("data:image/jpeg;base64,") center / cover;
  filter: saturate(0.86) contrast(1.02);
}

.hero::after {
  position: absolute;
  inset: 78px clamp(20px, 5vw, 64px) 34px;
  z-index: -1;
  border: 1px solid var(--line);
  content: "";
}

.hero-kicker {
  display: grid;
  justify-items: center;
  color: var(--cream);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.hero-kicker img {
  width: min(72vw, 560px);
  margin-bottom: 12px;
  filter: drop-shadow(0 24px 70px rgba(0, 0, 0, 0.54));
  opacity: 0.98;
}

.hero-copy {
  max-width: 880px;
  display: grid;
  justify-items: center;
  gap: 14px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
}

.eyebrow {
  margin: 0;
  color: var(--amber);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
