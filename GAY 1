  aspect-ratio: 4 / 3;
  margin: 0;
  border: 1px solid rgba(245, 239, 226, 0.1);
  background: #120c09;
}

.hours-photo::after {
  position: absolute;
  inset: 0;
  content: "";
  background: linear-gradient(90deg, rgba(19, 13, 10, 0.34), transparent 48%);
}

.hours-photo img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.72) saturate(0.9) contrast(1.08);
}

.open-mic-photo img {
  object-position: center;
  filter: brightness(0.86) saturate(0.88) contrast(1.08);
}

